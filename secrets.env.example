# Copy to ~/.config/linuswise/secrets.env and fill in. Keep it private:
#   chmod 600 ~/.config/linuswise/secrets.env
# The launchd daily agent and your shell both source this file.

# Gmail App Password (https://myaccount.google.com/apppasswords) — no spaces.
export LINUSWISE_SMTP_PASSWORD="xxxxxxxxxxxxxxxx"

# Groq API key for the Ask feature (https://console.groq.com/keys)
export GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxx"
